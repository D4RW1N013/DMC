# ---------------------------
# LLM
# ---------------------------
DMC_LLM_PROVIDER=ollama
DMC_OLLAMA_BASE_URL=http://127.0.0.1:11434
DMC_OLLAMA_MODEL=qwen3:8b

# Optional OpenAI-compatible endpoint
DMC_OPENAI_BASE_URL=
DMC_OPENAI_API_KEY=
DMC_OPENAI_MODEL=

# ---------------------------
# Email / IMAP
# ---------------------------
DMC_IMAP_HOST=
DMC_IMAP_PORT=993
DMC_EMAIL_ADDRESS=
DMC_EMAIL_PASSWORD=

# ---------------------------
# DMC
# ---------------------------
DMC_MEMORY_FILE=data/memory.json
DMC_WORKSPACE=workspace
DMC_MAX_TOOL_STEPS=12
DMC_REQUIRE_CONFIRMATION=true
